rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeProfile() {
      return signedIn() && userDoc().data.active == true;
    }

    function isPlatformAdmin() {
      return activeProfile()
        && userDoc().data.role in ['orquestra_admin', 'platform_owner'];
    }

    function belongsToTenant(tenantId) {
      return activeProfile() && userDoc().data.tenantId == tenantId;
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == userId);
      // Roles, tenant and status are changed only by the server through Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    match /companies/{tenantId} {
      allow read: if isPlatformAdmin() || belongsToTenant(tenantId);
      allow create, update, delete: if false;
    }

    match /managedServices/{serviceId} {
      allow read: if isPlatformAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // Kept during the transition from the original portal model.
    match /companyModules/{moduleAccessId} {
      allow read: if isPlatformAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    match /billingCharges/{chargeId} {
      allow read: if isPlatformAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isPlatformAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    match /usageSummaries/{summaryId} {
      allow read: if isPlatformAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    match /accessCommands/{commandId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /connectorEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isPlatformAdmin();
      // An audit trail is server-written. A browser must never forge audit events.
      allow create, update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if isPlatformAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if belongsToTenant(request.resource.data.tenantId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'tenantId', 'createdBy', 'subject', 'message', 'status', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if activeProfile();
      allow create, update, delete: if false;
    }
  }
}
